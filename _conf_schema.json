{
  "enablebilianalysis": {
    "description": "开启 B 站链接解析",
    "type": "bool",
    "default": true
  },
  "waitTip_Switch": {
    "description": "解析前的等待提示语",
    "type": "string",
    "default": ""
  },
  "videoParseMode": {
    "description": "允许触发的消息来源",
    "type": "list",
    "options": ["card", "link", "short", "id"],
    "default": ["card", "link", "short", "id"]
  },
  "parseLimit": {
    "description": "单条消息最多解析链接数",
    "type": "int",
    "default": 3
  },
  "bVideo_area": {
    "description": "通用消息模板",
    "type": "text",
    "default": "📺 ${标题} ${tab} 👤 ${UP主}\n📝 ${简介}\n👍 ${点赞} ${tab} 🪙 ${投币}\n⭐ ${收藏} ${tab} 🔁 ${转发}\n👀 ${观看} ${tab} 💬 ${弹幕}\n▶️ ${播放链接}\n${封面}\n${视频}"
  },
  "bVideoCard_area": {
    "description": "卡片消息模板",
    "type": "text",
    "default": "📺 ${标题}\n📝 ${简介}\n🪙 ${投币} ${tab} ⭐ ${收藏} ${tab} 🔁 ${转发}\n▶️ ${播放链接}\n🔗 ${视频地址}\n${封面}\n${视频}"
  },
  "bVideoShowIntroductionTofixed": {
    "description": "简介最大字符数",
    "type": "int",
    "default": 50
  },
  "useNumeral": {
    "description": "大数字缩写为万、亿",
    "type": "bool",
    "default": true
  },
  "bVideoIDPreference": {
    "description": "视频地址使用的视频号",
    "type": "string",
    "options": ["bv", "av"],
    "default": "bv"
  },
  "MaximumFileSizeMB": {
    "description": "视频最大下载大小，单位 MB",
    "type": "int",
    "default": 50
  },
  "sendVideo": {
    "description": "下载并发送视频",
    "type": "bool",
    "default": true
  },
  "isfigure": {
    "description": "开启合并转发",
    "type": "bool",
    "default": true
  },
  "MinimumTimeInterval": {
    "description": "同一链接最小处理间隔，单位秒",
    "type": "int",
    "default": 180
  },
  "preventSingleUserListAttack": {
    "description": "单用户解析频率限制",
    "type": "bool",
    "default": true
  },
  "requestMode": {
    "description": "解析 API 请求模式",
    "type": "string",
    "options": ["proxy", "direct", "parallel"],
    "default": "parallel"
  },
  "userAgent": {
    "description": "请求 B 站 API 的 User-Agent",
    "type": "string",
    "default": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"
  },
  "showError": {
    "description": "解析失败时提示",
    "type": "bool",
    "default": false
  },
  "loggerinfo": {
    "description": "开启调试日志",
    "type": "bool",
    "default": false
  },
  "loggerinfofulljson": {
    "description": "输出完整消息结构日志",
    "type": "bool",
    "default": false
  }
}
